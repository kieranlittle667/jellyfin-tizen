diff --git a/src/components/tizenAccessibility.js b/src/components/tizenAccessibility.js
new file mode 100644
index 0000000..a654b52
--- /dev/null
+++ b/src/components/tizenAccessibility.js
@@ -0,0 +1,144 @@
+import globalize from '../lib/globalize';
+
+// Use Samsung's native Voice Guide. Do not intercept keys or run a second TTS
+// engine: the existing remote navigation and the user's speech settings apply.
+// These keys are Samsung/Jellyfin material-icon class names.
+/* eslint-disable @typescript-eslint/naming-convention */
+const iconLabels = {
+    arrow_back: 'ButtonBack', chevron_left: 'ButtonBack', home: 'Home',
+    menu: 'Menu', search: 'Search', person: 'Settings', settings: 'Settings',
+    play_arrow: 'Play', pause: 'ButtonPause', stop: 'ButtonStop',
+    fast_rewind: 'Rewind', fast_forward: 'FastForward',
+    skip_previous: 'PreviousTrack', skip_next: 'NextTrack',
+    closed_caption: 'Subtitles', audiotrack: 'Audio',
+    more_vert: 'ButtonMore', sort_by_alpha: 'Sort', filter_alt: 'Filter',
+    cast: 'HeaderPlayOn', groups: 'ButtonSyncPlay',
+    music_note: 'VoiceGuideNowPlaying', volume_up: 'Mute', volume_off: 'Unmute',
+    arrow_forward: 'Next', fiber_manual_record: 'Record'
+};
+/* eslint-enable @typescript-eslint/naming-convention */
+const inferredNames = new WeakMap();
+let dialogTextId = 0;
+
+export function advanceLoginUsername(form, event, doc = document) {
+    const username = form.querySelector('#txtManualName');
+    const password = form.querySelector('#txtManualPassword');
+    if (username && password && doc.activeElement === username) {
+        // Samsung IME Done submits the form while the username still has
+        // focus. Finish that field and move to Password instead of attempting
+        // authentication with an empty password.
+        event.preventDefault();
+        password.focus();
+        return true;
+    }
+    return false;
+}
+
+function text(element) {
+    return element?.textContent?.replace(/\s+/g, ' ').trim() || '';
+}
+
+export function enhanceControl(element) {
+    if (!element || element.nodeType !== 1) return;
+    if (element.matches('input[type="hidden"]')) return;
+    const isControl = element.matches('button, a, input, select, textarea, [role="button"], [role="tab"]');
+    if (!isControl) return;
+
+    // Preserve authored labels and linked form labels, including passwords.
+    if (element.hasAttribute('aria-label') || element.hasAttribute('aria-labelledby')
+        || element.labels?.length) return;
+
+    let label = element.getAttribute('title') || element.getAttribute('placeholder');
+    const content = element.cloneNode(true);
+    content.querySelectorAll('[aria-hidden="true"], .material-icons').forEach(icon => {
+        icon.remove();
+    });
+    if (!label && !text(content)) {
+        const icon = element.querySelector('.material-icons');
+        const key = Object.keys(iconLabels).find(name => icon?.classList.contains(name));
+        if (key) label = globalize.translate(iconLabels[key]);
+    }
+    if (label) {
+        element.setAttribute('aria-label', label);
+        inferredNames.set(element, label);
+    }
+}
+
+export function enhanceDialog(dialog) {
+    dialog.setAttribute('role', 'dialog');
+    if (dialog.hasAttribute('modal')) dialog.setAttribute('aria-modal', 'true');
+    if (!dialog.hasAttribute('aria-label') && !dialog.hasAttribute('aria-labelledby')) {
+        const heading = dialog.querySelector('h1, h2, h3, .dialogTitle, .actionSheetTitle');
+        if (text(heading)) dialog.setAttribute('aria-label', text(heading));
+    }
+    const message = dialog.querySelector('.formDialogContent .text');
+    if (text(message) && !message.querySelector('input, button, select, textarea, a')) {
+        // Alerts otherwise focus only "Got it", leaving their instructions or
+        // Quick Connect code unreachable by the TV's directional navigation.
+        message.classList.add('focusable');
+        message.setAttribute('tabindex', '0');
+        message.setAttribute('autofocus', '');
+        if (!message.id) message.id = 'tizenDialogText' + (++dialogTextId);
+        if (!dialog.hasAttribute('aria-describedby')) dialog.setAttribute('aria-describedby', message.id);
+        dialog.querySelectorAll('button[autofocus]').forEach(button => {
+            button.removeAttribute('autofocus');
+        });
+    }
+}
+
+export function startTizenAccessibility(doc = document) {
+    let stopped = false;
+    let pending = false;
+    const roots = new Set();
+    function enhance(root) {
+        if (root.nodeType !== 1) return;
+        enhanceControl(root);
+        root.querySelectorAll('button, a, input, select, textarea, [role="button"], [role="tab"]')
+            .forEach(enhanceControl);
+        if (root.matches('.dialogContainer > .focuscontainer')) enhanceDialog(root);
+        root.querySelectorAll('.dialogContainer > .focuscontainer').forEach(enhanceDialog);
+    }
+    function flush() {
+        pending = false;
+        if (stopped) return;
+        roots.forEach(enhance);
+        roots.clear();
+    }
+    const observer = new MutationObserver(records => {
+        records.forEach(record => {
+            if (record.type === 'childList') {
+                record.addedNodes.forEach(node => {
+                    if (node.nodeType === 1) roots.add(node);
+                });
+            } else if (record.attributeName === 'title') {
+                // Titles of play/pause, mute and fullscreen controls change.
+                // Only refresh a label that this adapter previously inferred.
+                const element = record.target;
+                if (inferredNames.has(element)
+                    && element.getAttribute('aria-label') === inferredNames.get(element)) {
+                    element.removeAttribute('aria-label');
+                }
+                roots.add(element);
+            }
+        });
+        if (!pending && roots.size) {
+            pending = true;
+            Promise.resolve().then(flush);
+        }
+    });
+    enhance(doc.body);
+    observer.observe(doc.body, { childList: true, subtree: true,
+        attributes: true, attributeFilter: ['title'], attributeOldValue: true });
+    function onFocus(event) {
+        enhanceControl(event.target);
+        const startup = doc.getElementById('tizenVoiceGuideStartup');
+        if (startup && event.target !== startup) startup.remove();
+    }
+    doc.addEventListener('focus', onFocus, true);
+    return () => {
+        stopped = true;
+        observer.disconnect();
+        doc.removeEventListener('focus', onFocus, true);
+        roots.clear();
+    };
+}
diff --git a/src/components/tizenAccessibility.test.js b/src/components/tizenAccessibility.test.js
