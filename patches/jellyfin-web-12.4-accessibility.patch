@@ -0,0 +1,28 @@
+import { describe, expect, test, vi } from 'vitest';
+import dictionary from '../strings/en-us.json';
+vi.mock('../lib/globalize', () => ({ default: { translate: key => dictionary[key] || key } }));
+import { accessibleItemName } from './accessibleItemName';
+
+describe('spoken media descriptions', () => {
+    test('identifies series, season, episode, title and resume status', () => {
+        expect(accessibleItemName({ Type: 'Episode', SeriesName: 'A series', ParentIndexNumber: 2,
+            IndexNumber: 4, Name: 'A title', UserData: { PlaybackPositionTicks: 100 } }))
+            .toBe('A series, Season 2, Episode 4, A title, Resume');
+    });
+    test('handles specials and episode zero', () => {
+        expect(accessibleItemName({ Type: 'Episode', ParentIndexNumber: 0, IndexNumber: 0, Name: 'Special' }))
+            .toBe('Season 0, Episode 0, Special');
+    });
+    test('distinguishes remakes and exposes watched state', () => {
+        expect(accessibleItemName({ Type: 'Movie', Name: 'A film', ProductionYear: 2020, UserData: { Played: true } }))
+            .toBe('A film, 2020, Played');
+    });
+    test('includes a channel number or track artist', () => {
+        expect(accessibleItemName({ Type: 'TvChannel', Name: 'BBC ONE', ChannelNumber: '101' })).toBe('101, BBC ONE');
+        expect(accessibleItemName({ Type: 'Audio', Name: 'A song', Artists: ['An artist'] })).toBe('A song, An artist');
+    });
+    test('returns text rather than HTML and tolerates absent metadata', () => {
+        expect(accessibleItemName({ Name: '<A & B>' })).toBe('<A & B>');
+        expect(accessibleItemName({})).toBe('');
+    });
+});
