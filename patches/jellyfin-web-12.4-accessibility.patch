@@ -0,0 +1,133 @@
+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';
+import dictionary from '../strings/en-us.json';
+
+vi.mock('../lib/globalize', () => ({ default: { translate: key => dictionary[key] || key } }));
+import { advanceLoginUsername, enhanceControl, enhanceDialog, startTizenAccessibility } from './tizenAccessibility';
+
+let stopAdapter;
+beforeEach(() => {
+    document.body.innerHTML = '';
+});
+afterEach(() => {
+    stopAdapter?.();
+    stopAdapter = null;
+});
+const settle = async () => {
+    await new Promise(resolve => setTimeout(resolve, 0));
+};
+
+describe('Samsung Voice Guide semantics', () => {
+    test.each(['', 'existing-value'])('username Done advances without submitting credentials (%s)', passwordValue => {
+        document.body.innerHTML = '<form><input id="txtManualName"><input id="txtManualPassword" type="password"><button>Sign In</button></form>';
+        const form = document.querySelector('form');
+        const username = form.querySelector('#txtManualName');
+        const password = form.querySelector('#txtManualPassword');
+        password.value = passwordValue;
+        username.focus();
+        const event = new Event('submit', { cancelable: true });
+        expect(advanceLoginUsername(form, event)).toBe(true);
+        expect(event.defaultPrevented).toBe(true);
+        expect(document.activeElement).toBe(password);
+        expect(password.value).toBe(passwordValue);
+    });
+
+    test.each(['#txtManualPassword', 'button'])('password Done and explicit Sign In still submit (%s)', selector => {
+        document.body.innerHTML = '<form><input id="txtManualName"><input id="txtManualPassword" type="password"><button>Sign In</button></form>';
+        const form = document.querySelector('form');
+        form.querySelector(selector).focus();
+        const event = new Event('submit', { cancelable: true });
+        expect(advanceLoginUsername(form, event)).toBe(false);
+        expect(event.defaultPrevented).toBe(false);
+    });
+    test.each([
+        ['arrow_back', 'Back'], ['home', 'Home'], ['menu', 'Menu'],
+        ['search', 'Search'], ['person', 'Settings'], ['play_arrow', 'Play'],
+        ['pause', 'Pause'], ['stop', 'Stop'], ['closed_caption', 'Subtitles'],
+        ['audiotrack', 'Audio'], ['more_vert', 'More'], ['cast', 'Play On'],
+        ['groups', 'SyncPlay'], ['music_note', 'Now playing']
+    ])('names the %s icon without speaking the icon font', (icon, label) => {
+        document.body.innerHTML = `<button><span class="material-icons ${icon}" aria-hidden="true">${icon}</span></button>`;
+        enhanceControl(document.querySelector('button'));
+        expect(document.querySelector('button').getAttribute('aria-label')).toBe(label);
+    });
+
+    test('preserves authored names and form labels, without exposing password values', () => {
+        document.body.innerHTML = '<button aria-label="Existing" title="Other"></button><label for="pw">Password</label><input id="pw" type="password" value="never-speak-this"><input type="hidden" value="token">';
+        stopAdapter = startTizenAccessibility();
+        expect(document.querySelector('button').getAttribute('aria-label')).toBe('Existing');
+        expect(document.querySelector('#pw').hasAttribute('aria-label')).toBe(false);
+        expect(document.body.innerHTML).not.toContain('aria-label="never-speak-this"');
+        expect(document.querySelector('[type="hidden"]').hasAttribute('aria-label')).toBe(false);
+    });
+
+    test('names controls inserted after login or a route change', async () => {
+        stopAdapter = startTizenAccessibility();
+        document.body.innerHTML = '<button title="Subtitles"></button><input placeholder="Search your library">';
+        await settle();
+        expect(document.querySelector('button').getAttribute('aria-label')).toBe('Subtitles');
+        expect(document.querySelector('input').getAttribute('aria-label')).toBe('Search your library');
+    });
+
+    test('updates inferred names when the title changes without clobbering an authored name', async () => {
+        document.body.innerHTML = '<button title="Play"></button><button title="Old" aria-label="Explicit"></button>';
+        stopAdapter = startTizenAccessibility();
+        const [play, authored] = document.querySelectorAll('button');
+        play.title = 'Pause';
+        authored.title = 'New';
+        await settle();
+        expect(play.getAttribute('aria-label')).toBe('Pause');
+        expect(authored.getAttribute('aria-label')).toBe('Explicit');
+    });
+
+    test('retains actual keyboard focus and leaves arrow and Back handling untouched', () => {
+        document.body.innerHTML = '<button id="tizenVoiceGuideStartup" autofocus>Starting</button><button title="Play"></button><button title="Settings"></button>';
+        stopAdapter = startTizenAccessibility();
+        const play = document.querySelector('[title="Play"]');
+        play.focus();
+        expect(document.activeElement).toBe(play);
+        expect(document.getElementById('tizenVoiceGuideStartup')).toBeNull();
+        for (const key of ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Back']) {
+            const event = new KeyboardEvent('keydown', { key, bubbles: true, cancelable: true });
+            play.dispatchEvent(event);
+            expect(event.defaultPrevented).toBe(false);
+            expect(document.activeElement).toBe(play);
+        }
+    });
+
+    test('makes a modal track-selection dialog discoverable by name', () => {
+        document.body.innerHTML = '<div modal><h2>Audio tracks</h2><button>English audio description</button></div>';
+        const dialog = document.body.firstElementChild;
+        enhanceDialog(dialog);
+        expect(dialog.getAttribute('role')).toBe('dialog');
+        expect(dialog.getAttribute('aria-modal')).toBe('true');
+        expect(dialog.getAttribute('aria-label')).toBe('Audio tracks');
+    });
+
+    test('focuses the Quick Connect instructions before its dismiss button', () => {
+        document.body.innerHTML = '<div modal><h1>Quick Connect</h1><div class="formDialogContent"><div class="text">Enter 1 2 3 4 5 6 on your other device</div></div><button autofocus>Got it</button></div>';
+        const dialog = document.body.firstElementChild;
+        enhanceDialog(dialog);
+        const message = dialog.querySelector('.text');
+        expect(message.tabIndex).toBe(0);
+        expect(message.hasAttribute('autofocus')).toBe(true);
+        expect(dialog.querySelector('button').hasAttribute('autofocus')).toBe(false);
+        expect(dialog.getAttribute('aria-describedby')).toBe(message.id);
+    });
+
+    test('preserves form focus in a dialog with interactive content', () => {
+        document.body.innerHTML = '<div><div class="formDialogContent"><div class="text">Username<input></div></div><button autofocus>Save</button></div>';
+        const dialog = document.body.firstElementChild;
+        enhanceDialog(dialog);
+        expect(dialog.querySelector('button').hasAttribute('autofocus')).toBe(true);
+        expect(dialog.querySelector('.text').hasAttribute('tabindex')).toBe(false);
+    });
+
+    test('does not create speech timers or change settings after cleanup', async () => {
+        stopAdapter = startTizenAccessibility();
+        stopAdapter();
+        stopAdapter = null;
+        document.body.innerHTML = '<button title="Later"></button>';
+        await settle();
+        expect(document.querySelector('button').hasAttribute('aria-label')).toBe(false);
+    });
+});
