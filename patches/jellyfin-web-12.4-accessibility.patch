diff --git a/src/components/accessibleItemName.js b/src/components/accessibleItemName.js
new file mode 100644
index 0000000..b1999c4
--- /dev/null
+++ b/src/components/accessibleItemName.js
@@ -0,0 +1,18 @@
+import globalize from '../lib/globalize';
+
+// Distinguish identically named episodes and expose visual status indicators.
+export function accessibleItemName(item) {
+    const parts = [];
+    if (item.Type === 'Episode') {
+        if (item.SeriesName) parts.push(item.SeriesName);
+        if (item.ParentIndexNumber != null) parts.push(globalize.translate('Season') + ' ' + item.ParentIndexNumber);
+        if (item.IndexNumber != null) parts.push(globalize.translate('Episode') + ' ' + item.IndexNumber);
+    }
+    if (item.ChannelNumber) parts.push(item.ChannelNumber);
+    if (item.Name) parts.push(item.Name);
+    if (item.Type === 'Movie' && item.ProductionYear) parts.push(String(item.ProductionYear));
+    if (item.Type === 'Audio' && item.Artists?.length) parts.push(item.Artists.join(', '));
+    if (item.UserData?.Played) parts.push(globalize.translate('Played'));
+    else if (item.UserData?.PlaybackPositionTicks > 0) parts.push(globalize.translate('ButtonResume'));
+    return parts.join(', ');
+}
